PROFILE_NAME=prototype-freeze
RPC_URL=https://api.devnet.solana.com
OPENJACK_PROGRAM_ID=REPLACE_WITH_PROGRAM_ID
OPENJACK_IDL_PATH="/ABS/PATH/TO/REPO/target/idl/openjack.json"
OPENJACK_API_BASE=http://localhost:8080
DATABASE_URL=postgres://localhost:5432/openjack
SCANNER_KEYPAIR_PATH=~/.config/solana/id.json
AUTHORITY_KEYPAIR_PATH=~/.config/solana/id.json
VRF_CALLBACK_KEYPAIR_PATH=~/.config/solana/id.json
INGEST_API_KEY=dev-ingest-key
OPENJACK_EVENT_SOURCE_MODE=rpc
OPENJACK_RPC_LOOKBACK_LIMIT=120
OPENJACK_SCAN_INTERVAL_SECS=8
OPENJACK_PROOF_MODE=off
OPENJACK_TREE_ADDRESS=REPLACE_WITH_TREE_ADDRESS
OPENJACK_TREE_CONFIG_ADDRESS=REPLACE_WITH_TREE_CONFIG_ADDRESS
OPENJACK_ASSET_RESOLVER_MODE=postgres
OPENJACK_AUTO_FULFILL_DRAW=true
OPENJACK_CLOSE_IN_SECS=120
OPENJACK_ORACLE_MAX_AGE_SECS=600
OPENJACK_GATE_SKIP_AUTO_CLAIM=true
