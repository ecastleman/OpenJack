{
  "name": "openjack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "api": "npm --prefix services/api run start",
    "scanner": "npm --prefix services/scanner run start",
    "scanner:daemon": "OPENJACK_SCANNER_MODE=daemon SCANNER_PUBLISH_MODE=live OPENJACK_PERSIST_EVENTS=true npm run scanner",
    "web": "npm --prefix apps/web run dev",
    "e2e:devnet": "node scripts/devnet-e2e-openjack.mjs",
    "preflight": "bash scripts/preflight-local.sh",
    "seeker:smoke": "node scripts/seeker-smoke.mjs",
    "seeker:report": "SMOKE_WRITE_REPORT=true node scripts/seeker-smoke.mjs",
    "seeker:ready": "node scripts/seeker-ready-check.mjs",
    "seeker:beta": "node scripts/seeker-beta.mjs",
    "seeker:live": "node scripts/seeker-live-checklist.mjs",
    "seeker:vertical": "node scripts/seeker-vertical.mjs",
    "gate:protocol": "node scripts/protocol-gate.mjs",
    "claim:gate-report": "node scripts/claim-from-gate-report.mjs",
    "claim:gate-all": "node scripts/claim-from-all-gate-reports.mjs",
    "claim:gate-latest": "node scripts/claim-from-gate-report.mjs",
    "gate:post-report": "node scripts/post-gate-report.mjs",
    "gate:post-latest": "node scripts/post-gate-report.mjs",
    "hydrate:gate-all": "node scripts/hydrate-from-all-gate-reports.mjs",
    "hydrate:gate-pending": "node scripts/hydrate-from-pending-gate-reports.mjs",
    "hydrate:rehydrate-failed-round": "node scripts/rehydrate-failed-round.mjs",
    "hydrate:cleanup-status": "node scripts/cleanup-proof-hydration.mjs",
    "verify:claimed-round": "node scripts/verify-claimed-round.mjs",
    "run:clean-cycle": "bash scripts/run-clean-cycle.sh",
    "gate:with-stack": "bash scripts/run-gate-with-stack.sh",
    "rc:checklist": "node scripts/rc-checklist.mjs",
    "keeper": "node scripts/round-orchestrator.mjs",
    "scanner:set-official": "node scripts/set-official-scanner.mjs",
    "treasury:set": "node scripts/set-treasury.mjs",
    "ticket-price:set": "node scripts/set-ticket-price.mjs",
    "vrf:set-callback": "node scripts/set-vrf-callback.mjs",
    "config:verify": "node scripts/verify-config.mjs",
    "config:init": "node scripts/init-config.mjs",
    "tree:init": "node scripts/init-cnft-tree.mjs",
    "round:create-open": "node scripts/create-open-round.mjs",
    "round:predict-winning-ticket": "node scripts/predict-winning-ticket.mjs",
    "count-batch:run": "node scripts/prototype-run-count-batch.mjs",
    "count-batch:status": "node scripts/count-batch-status.mjs",
    "count-batch:failures": "node scripts/count-batch-failures.mjs",
    "fast-path:mock-harness": "node scripts/fast-path-mock-harness.mjs",
    "debug:prepare-buy": "node scripts/debug-prepare-buy.mjs",
    "oracle:set-max-age": "node scripts/set-oracle-max-age.mjs",
    "with-profile": "node scripts/with-profile.mjs",
    "vertical:dev-fast": "node scripts/with-profile.mjs dev-fast npm run seeker:vertical",
    "vertical:qa-fast": "node scripts/with-profile.mjs qa-fast npm run seeker:vertical",
    "vertical:prod-like": "node scripts/with-profile.mjs prod-like npm run seeker:vertical",
    "round:create-open:dev-fast": "node scripts/with-profile.mjs dev-fast npm run round:create-open",
    "round:create-open:qa-fast": "node scripts/with-profile.mjs qa-fast npm run round:create-open",
    "round:create-open:prod-like": "node scripts/with-profile.mjs prod-like npm run round:create-open",
    "launch:dev-fast": "bash scripts/launch-dev-fast.sh",
    "launch:qa-fast": "bash scripts/launch-qa-fast.sh",
    "launch:prod-like": "bash scripts/launch-prod-like.sh",
    "deploy:dev-fast": "bash scripts/deploy-dev-fast.sh",
    "deploy:qa-fast": "bash scripts/deploy-qa-fast.sh",
    "deploy:prototype-freeze": "bash scripts/deploy-prototype-freeze.sh",
    "deploy:prod-like": "bash scripts/deploy-prod-like.sh",
    "round:prototype-freeze": "node scripts/prototype-freeze-round.mjs",
    "build:program:prod-like": "anchor build",
    "build:program:dev-fast": "anchor build -- --features dev-fast-timers,dev-fast-program-id",
    "build:program:qa-fast": "anchor build -- --features qa-fast-timers,dev-fast-program-id",
    "test:contract": "node --test tests/contract/*.test.mjs"
  },
  "dependencies": {
    "bs58": "^6.0.0"
  }
}
